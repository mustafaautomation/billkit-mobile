# Leave these unset to run the seeded demo with no network account.
# Set both to use the same Supabase project as the Billkit web app.
# Use the anon or publishable key only. Never put a service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias accepted by the client. The anon key above wins when both are set.
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Stripe Checkout is created by the Supabase edge function, not by this app.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
